{
  "name": "dsh-media-library",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "Browse, play and tag media in explicitly designated DSH projects.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vb2250158/dsh-media-library.git"
  },
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "locale",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "tested-environment.json",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24.9.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:client": "node tests/grid-interaction.mjs",
    "build": "node scripts/check.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.2.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.2.2-rc.1 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "license": "MIT"
}
